# RAGnarock configuration. Copy to .env and adjust.
#
# docker compose reads this file from the repository root. Values declared
# inline in a compose file take precedence, so this file mainly serves native
# runs (`uv run uvicorn ...`) and compose interpolation (passwords, hostnames).

# --- core -------------------------------------------------------------------
APP_ENV=development
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- database ---------------------------------------------------------------
# Inside compose the API uses the service name `db`. For a native run against
# the debug profile, use localhost:
# DATABASE_URL=postgresql+psycopg://ragnarock:ragnarock@localhost:5432/ragnarock
DATABASE_URL=postgresql+psycopg://ragnarock:ragnarock@db:5432/ragnarock

# --- storage ----------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_PATH=/data/uploads
MAX_UPLOAD_MB=10
# Comma-separated; parsed without JSON quoting.
ALLOWED_MIME_TYPES=text/plain,text/markdown

# --- embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# --- generation -------------------------------------------------------------
# Native development uses the deterministic fake provider so chat works without
# a key. Docker development forces fake; Docker production forces openrouter and
# requires a per-request X-Provider-Key header (BYOK). Never put a provider key
# in this file.
LLM_PROVIDER=fake
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TEMPERATURE=0.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://ollama:11434
ALLOW_SERVER_LLM_KEY=false

# --- retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.30
CONTEXT_MAX_TOKENS=6000

# --- auth and sessions ------------------------------------------------------
# AUTH_DISABLED must be false when APP_ENV=production.
AUTH_DISABLED=true
# JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
GUEST_SESSION_TTL_HOURS=168
MAX_DOCS_PER_SESSION=5

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_CHAT_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=3

# --- hosted SPA and CORS ----------------------------------------------------
# Exact browser origins allowed to call the API. Leave empty locally (Vite
# proxies /api). Production sets the Vercel origin; never use "*".
# The frontend reads VITE_API_BASE_URL at build time; set it in the Vercel
# project, not here.
ALLOWED_ORIGINS=

# --- compose-only (hosted profile) -----------------------------------------
# POSTGRES_PASSWORD must be URL-safe if it is embedded in DATABASE_URL.
# POSTGRES_PASSWORD=
# SITE_ADDRESS=example.com
# API_WORKERS=2
